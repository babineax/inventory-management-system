rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to upload and read profile images
    match /profile_images/{imageId} {
      allow read, write: if request.auth != null;
      allow delete: if request.auth != null && 
        (request.auth.uid == resource.metadata.uploadedBy || 
         get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Allow authenticated users to upload and read inventory images
    match /inventory_images/{imageId} {
      allow read, write: if request.auth != null;
      allow delete: if request.auth != null && 
        get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // General rule for any other images
    match /images/{imageId} {
      allow read, write: if request.auth != null;
    }
  }
}